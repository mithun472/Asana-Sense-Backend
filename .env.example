# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/asana_sense?retryWrites=true&w=majority

# JWT Secret Key (generate a random 256-bit key)
JWT_SECRET=your-super-secret-jwt-key-change-this

# JWT token expiration in minutes
JWT_EXPIRY_MINUTES=1440

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Model paths (relative to backend directory; auto-resolves ../ml/models/ or ../)
TFLITE_MODEL_PATH=../ml/models/yoga_pose_classifier.tflite

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000


# Groq API Key (for AI session report generation, llama-3.3-70b-versatile)
GROQ_API_KEY=your-groq-api-key

# AES-256 key for encrypting sensitive profile fields (name, bmi_data) at rest.
# Generate with:
#   python -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
PROFILE_ENCRYPTION_KEY=your-32-byte-urlsafe-base64-key

