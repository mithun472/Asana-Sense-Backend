# MongoDB Atlas connection string
# Get this from Atlas -> Database -> Connect -> Drivers -> Python
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
DB_NAME=asana_sense
POSES_COLLECTION=poses

# Path to your trained Extra Trees model (joblib/pickle file)
MODEL_PATH=model_files/extra_trees_pose_model.pkl

# Optional: if you saved a LabelEncoder separately for pose class names
LABEL_ENCODER_PATH=model_files/label_encoder.pkl

# Minimum confidence to trust a prediction (0-1)
CONFIDENCE_THRESHOLD=0.6
